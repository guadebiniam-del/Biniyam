# Built artifacts and Gradle caches
.gradle/
# Ignore general .build-outputs except the binary APK and HTML downloader
.build-outputs/*
!.build-outputs/app-debug.apk
!.build-outputs/download_apk.html

# Explicitly track/allow the visible apks folder and its contents
!apks/
!apks/*
app/build/
build/
local.properties

# Android Studio / IntelliJ files
.idea/
*.iml
*.ipr
*.iws

# OS files
.DS_Store
Thumbs.db

# Signing files
*.keystore
*.jks
debug.keystore.base64
